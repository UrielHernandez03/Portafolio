---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { projectsData } from "../../data/projectsData";
---

<Layout>
  <Navbar />
  <main style="padding-top: 100px; min-height: 80vh;">
    <section id="proyectos-todos" class="section">
      <div class="container">
        <a href="/#proyectos" class="btn-back">
          &larr; Volver al inicio
        </a>
        <div class="section-header reveal">
          <span class="section-label">// TODOS LOS PROYECTOS</span>
          <h2 class="section-title">Mi <span class="gradient-text">Portafolio</span></h2>
          <p class="section-subtitle">
            Aquí puedes explorar todos los proyectos y casos de estudio que he desarrollado.
          </p>
        </div>

        <div class="projects-grid">
          {Object.values(projectsData).map((project) => (
            <article class="project-card reveal">
              <div class="project-img-wrapper">
                <img src={
                  project.id === 'landysystem' ? '/images/landysystem-dashboard.png' :
                  project.id === 'landypos' ? '/images/landysystem-pos.png' :
                  project.id === 'seat-calidad-bd' ? '/images/seat-dashboard.jpg' :
                  project.id === 'inventorypro' ? '/images/inventorypro.png' :
                  '/images/historias-en-papel.webp'
                } alt={project.title} loading="lazy" />
                <div class="project-badge">
                  {project.subtitle.split(' ')[0]}
                </div>
              </div>
              <div class="project-info">
                <h3 class="project-title">{project.title}</h3>
                <p class="project-description">
                  {project.description[0].substring(0, 100)}...
                </p>
                <p class="project-highlight">{project.subtitle}</p>
                <div class="project-tags">
                  <span class="project-tag">Case Study</span>
                </div>
                <div class="project-links">
                  <a href={`/proyecto/${project.id}`} class="btn-ver">Ver Caso de Estudio &rarr;</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* ── Projects Grid ── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  /* ── Project Card ── */
  .project-card {
    display: flex;
    flex-direction: column;
    background: #111827;
    border-radius: 20px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .project-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
  }

  [data-theme="light"] .project-card {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }

  /* ── Images ── */
  .project-img-wrapper {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
  }

  .project-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .project-card:hover .project-img-wrapper img {
    transform: scale(1.03);
  }

  /* ── Badge inside Image ── */
  .project-badge {
    position: absolute;
    bottom: 15px;
    left: 15px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #fff;
    z-index: 2;
  }

  /* ── Info ── */
  .project-info {
    display: flex;
    flex-direction: column;
    padding: 1.8rem;
    flex: 1;
    gap: 1.2rem;
  }

  .project-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: #f8fafc;
  }

  [data-theme="light"] .project-title {
    color: #0f172a;
  }

  .project-description {
    font-size: 0.95rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  [data-theme="light"] .project-description {
    color: #475569;
  }

  .project-highlight {
    font-size: 0.9rem;
    color: #38bdf8;
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }

  [data-theme="light"] .project-highlight {
    color: #0284c7;
  }

  /* Tags */
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .project-tag {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 50px;
  }

  [data-theme="light"] .project-tag {
    color: #334155;
    background: rgba(0, 0, 0, 0.05);
  }

  /* Links */
  .project-links {
    margin-top: 0.5rem;
  }

  .btn-ver {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.4rem;
    font-size: 0.9rem;
    font-weight: 500;
    border-radius: 50px;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #e0f2fe;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  [data-theme="light"] .btn-ver {
    background: rgba(14, 165, 233, 0.1);
    border-color: rgba(14, 165, 233, 0.3);
    color: #0369a1;
  }

  .btn-ver:hover {
    background: rgba(56, 189, 248, 0.2);
    border-color: rgba(56, 189, 248, 0.5);
  }

  /* Back Button */
  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e2e8f0;
    text-decoration: none;
    transition: all 0.2s ease;
    margin-bottom: 2rem;
  }
  
  [data-theme="light"] .btn-back {
    background: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.1);
    color: #334155;
  }

  .btn-back:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    color: #fff;
    transform: translateX(-4px);
  }
  
  [data-theme="light"] .btn-back:hover {
    background: rgba(0, 0, 0, 0.08);
    color: #000;
  }
</style>
