---
const { lang = 'es' } = Astro.props;

const t = {
  es: {
    sectionLabel: "// CONÓCEME",
    sectionTitle: "Sobre",
    sectionTitleHighlight: "Mí",
    p1: "Soy un desarrollador de software apasionado por la creación de soluciones tecnológicas innovadoras, comprometido con la calidad, la responsabilidad y el cumplimiento de objetivos.",
    p2: "Disfruto enfrentar desafíos, ya que considero que cada reto representa una oportunidad para fortalecer mis habilidades y generar un impacto positivo a través de la tecnología.",
    p3: "Trabajo con dedicación, perseverancia y una actitud orientada a la mejora continua. Me adapto con facilidad a nuevos entornos y me comprometo plenamente con cada proyecto.",
    stat1: "Años de<br>experiencia",
    stat2: "Proyectos<br>completados",
    stat3: "Certificaciones<br>obtenidas",
  },
  en: {
    sectionLabel: "// GET TO KNOW ME",
    sectionTitle: "About",
    sectionTitleHighlight: "Me",
    p1: "I am a software developer passionate about creating innovative technological solutions, committed to quality, responsibility, and achieving goals.",
    p2: "I enjoy facing challenges, as I believe every challenge represents an opportunity to strengthen my skills and generate a positive impact through technology.",
    p3: "I work with dedication, perseverance, and an attitude oriented towards continuous improvement. I adapt easily to new environments and fully commit to every project.",
    stat1: "Years of<br>experience",
    stat2: "Projects<br>completed",
    stat3: "Certifications<br>earned",
  }
}[lang as 'es' | 'en'] || t['es'];

import { projectsData } from '../data/projectsData';
const projectsCount = Object.keys(projectsData).length;
---

<section id="sobre-mi" class="section about-section">
  <div class="container">

    <div class="section-header reveal">
      <span class="section-label">{t.sectionLabel}</span>
      <h2 class="section-title">{t.sectionTitle} <span class="gradient-text">{t.sectionTitleHighlight}</span></h2>
    </div>

    <div class="about-wrap section-card reveal reveal-delay-1">

      <!-- ── Columna izquierda: foto ── -->
      <div class="about-col-left">
        <div class="about-photo-frame">
          <img src="/images/profile.jpg.JPG" alt="Uriel Hernández" class="about-photo" />
        </div>


      </div>

      <!-- ── Columna derecha: texto + stats ── -->
      <div class="about-col-right">

        <div class="about-bio glass">
          <p>{t.p1}</p>
          <p>{t.p2}</p>
          <p>{t.p3}</p>
        </div>

        <div class="about-stats">
          <div class="about-stat glass">
            <span class="stat-num gradient-text">2+</span>
            <span class="stat-lbl" set:html={t.stat1}></span>
          </div>
          <div class="about-stat glass">
            <span class="stat-num gradient-text">{projectsCount}+</span>
            <span class="stat-lbl" set:html={t.stat2}></span>
          </div>
          <div class="about-stat glass">
            <span class="stat-num gradient-text">4</span>
            <span class="stat-lbl" set:html={t.stat3}></span>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .about-section {
    padding-top: 5rem;
    padding-bottom: 6rem;
  }

  /* ── Wrapper principal: 2 columnas ── */
  .about-wrap {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 4rem;
    align-items: center;
    max-width: 950px;
    margin: 0 auto;
  }

  /* ─────────── Columna izquierda ─────────── */
  .about-col-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .about-photo-frame {
    width: 220px;
    height: 270px;
    border-radius: 18px;
    overflow: hidden;
    border: 2px solid rgba(99, 102, 241, 0.35);
    box-shadow:
      0 0 35px rgba(99, 102, 241, 0.18),
      0 20px 40px rgba(0,0,0,0.4);
    flex-shrink: 0;
  }

  .about-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  /* Badges debajo de la foto */
  .about-badges {
    display: flex;
    gap: 0.6rem;
  }

  .about-badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    background: rgba(99, 102, 241, 0.08);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 50px;
    font-size: 0.82rem;
    font-weight: 500;
    color: #c7d2fe;
  }

  .badge-icon {
    font-size: 0.9rem;
  }

  /* ─────────── Columna derecha ─────────── */
  .about-col-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Bio */
  .about-bio {
    padding: 2rem 2.25rem;
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .about-bio p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Stats */
  .about-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .about-stat {
    padding: 1.25rem 0.75rem;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
  }

  .stat-num {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stat-lbl {
    font-size: 0.78rem;
    color: var(--text-secondary);
    font-weight: 500;
    line-height: 1.4;
  }

  /* ─────────── LIGHT MODE OVERRIDES ─────────── */
  [data-theme="light"] .about-photo-frame {
    border-color: rgba(35, 83, 71, 0.35);
    box-shadow: 0 0 35px rgba(35, 83, 71, 0.18), 0 20px 40px rgba(0,0,0,0.1);
  }
  [data-theme="light"] .about-badge {
    background: rgba(35, 83, 71, 0.08);
    border-color: rgba(35, 83, 71, 0.2);
    color: var(--text-primary);
  }
  [data-theme="light"] .about-stat {
    background: rgba(35, 83, 71, 0.08);
    border-color: rgba(35, 83, 71, 0.2);
  }
  [data-theme="light"] .about-bio {
    background: var(--bg-surface);
  }

  /* ─────────── Responsive ─────────── */
  @media (max-width: 768px) {
    .about-wrap {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .about-col-left {
      flex-direction: row;
      align-items: flex-start;
      gap: 1.5rem;
    }
    .about-photo-frame {
      width: 120px;
      height: 150px;
      flex-shrink: 0;
    }
    .about-badges {
      flex-direction: column;
    }
    .about-bio {
      padding: 1.5rem;
    }
    .about-stats {
      grid-template-columns: repeat(3, 1fr);
    }
    .stat-num {
      font-size: 1.5rem;
    }
  }
</style>
