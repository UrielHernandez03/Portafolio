---

<section id="stack" class="section tech-section">
  <div class="orb orb-primary"   style="width:700px;height:700px;top:-200px;right:-250px;opacity:0.07;"></div>
  <div class="orb orb-secondary" style="width:500px;height:500px;bottom:-150px;left:-200px;opacity:0.06;"></div>

  <div class="container">

    <!-- ─── Header ─── -->
    <div class="section-header reveal">
      <span class="section-label">{t.sectionLabel}</span>
      <h2 class="section-title" set:html={t.sectionTitle}></h2>
      <p class="section-subtitle">
        {t.sectionSubtitle}
      </p>
    </div>

    <!-- ─── Platform Toggle ─── -->
    <!-- ─── Tab Nav ─── -->
    <div class="tabs-wrapper reveal reveal-delay-1">
      <nav class="tabs-nav" id="techTabs" role="tablist">
        {categories.map((cat, i) => (
          <button
            class={`tab-btn${i === 0 ? ' active' : ''}`}
            data-tab={cat.id}
            role="tab"
            style={`--accent:${cat.accent};--color:${cat.color};`}
            aria-selected={i === 0 ? "true" : "false"}
          >
            <span class="tab-pip"></span>
            <span class="tab-label">{cat.name}</span>
            <span class="tab-count" data-cat={cat.id}>{cat.techs.length}</span>
          </button>
        ))}
      </nav>
    </div>

    <!-- ─── Panels ─── -->
    <div class="panels-root">
      {categories.map((cat, i) => (
        <div
          class={`tech-panel${i === 0 ? ' active' : ''}`}
          id={`panel-${cat.id}`}
          role="tabpanel"
          style={`--accent:${cat.accent};--color:${cat.color};`}
        >
          <div class="cards-grid">
            {cat.techs.map((tech, j) => (
              <div class="t-card" style={`--d:${j * 0.055}s;`}>
                <div class="t-card-shine"></div>
                <div class="t-card-glow"></div>
                <div class="t-icon">
                  <Fragment set:html={icons[tech.icon]} />
                </div>
                <p class="t-name">{tech.name}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
/* ─── Section ─── */
.tech-section { position: relative; overflow: hidden; }

/* ─────────────────────────────────────
   PLATFORM TOGGLE
───────────────────────────────────── */
.platform-row {
  display: flex;
  justify-content: center;
  margin-top: 3rem;
}

.platform-toggle {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 2px;
  padding: 5px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.09);
  border-radius: 999px;
  backdrop-filter: blur(12px);
}

.plat-btn {
  position: relative;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 0.5rem 1.2rem;
  border-radius: 999px;
  font-size: 0.83rem;
  font-weight: 500;
  font-family: var(--font-sans);
  color: var(--text-secondary);
  background: transparent;
  border: none;
  cursor: pointer;
  transition: color 0.22s ease;
  white-space: nowrap;
}

.plat-btn svg { flex-shrink: 0; transition: color 0.22s; }
.plat-btn:hover { color: var(--text-primary); }
.plat-btn.active { color: var(--text-primary); font-weight: 600; }

/* Sliding pill */
.plat-slider {
  position: absolute;
  top: 5px;
  bottom: 5px;
  left: 5px;
  border-radius: 999px;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.12);
  transition: transform 0.3s cubic-bezier(0.16,1,0.3,1), width 0.3s cubic-bezier(0.16,1,0.3,1);
  pointer-events: none;
  z-index: 1;
}

/* ─────────────────────────────────────
   TABS
───────────────────────────────────── */
.tabs-wrapper {
  margin-top: 1.25rem;
  display: flex;
  justify-content: center;
}

.tabs-nav {
  display: inline-flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.35rem;
  padding: 5px;
  background: var(--bg-glass);
  border: 1px solid var(--border-glass);
  border-radius: 999px;
  backdrop-filter: blur(10px);
}

.tab-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.5rem 1.1rem;
  border-radius: 999px;
  font-size: 0.81rem;
  font-weight: 500;
  font-family: var(--font-sans);
  color: var(--text-secondary);
  background: transparent;
  border: none;
  cursor: pointer;
  transition: color 0.2s, background 0.2s, box-shadow 0.2s;
  white-space: nowrap;
}

.tab-pip {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--color);
  opacity: 0.3;
  flex-shrink: 0;
  transition: opacity 0.2s;
}

.tab-count {
  font-size: 0.65rem;
  font-family: var(--font-mono);
  background: rgba(var(--accent), 0.14);
  color: var(--color);
  padding: 1px 5px;
  border-radius: 999px;
  transition: opacity 0.2s;
  min-width: 18px;
  text-align: center;
}

.tab-btn:hover { color: var(--text-primary); }
.tab-btn:hover .tab-pip { opacity: 0.6; }

.tab-btn.active {
  background: rgba(var(--accent), 0.13);
  color: var(--color);
  box-shadow: 0 0 0 1px rgba(var(--accent), 0.26), 0 2px 10px rgba(var(--accent), 0.1);
}
.tab-btn.active .tab-pip { opacity: 1; }

/* ─────────────────────────────────────
   PANELS
───────────────────────────────────── */
.panels-root { margin-top: 2rem; min-height: 280px; }

.tech-panel { display: none; }
.tech-panel.active {
  display: block;
  animation: panelIn 0.35s cubic-bezier(0.16,1,0.3,1) both;
}

@keyframes panelIn {
  from { opacity:0; transform:translateY(18px); }
  to   { opacity:1; transform:translateY(0); }
}

/* ─────────────────────────────────────
   CARDS GRID
───────────────────────────────────── */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 0.9rem;
}
@media (min-width:420px){ .cards-grid{ grid-template-columns:repeat(3,1fr); } }
@media (min-width:600px){ .cards-grid{ grid-template-columns:repeat(4,1fr); } }
@media (min-width:900px){ .cards-grid{ grid-template-columns:repeat(5,1fr); } }

/* ─────────────────────────────────────
   TECH CARD
───────────────────────────────────── */
.t-card {
  position: relative;
  border-radius: 18px;
  background: var(--bg-glass);
  border: 1px solid var(--border-glass);
  padding: 1.6rem 1rem 1.15rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.8rem;
  cursor: default;
  overflow: hidden;
  animation: cardPop 0.42s cubic-bezier(0.16,1,0.3,1) both;
  animation-delay: var(--d,0s);
  transition: transform 0.28s cubic-bezier(0.16,1,0.3,1),
              border-color 0.25s, background 0.25s, box-shadow 0.28s, opacity 0.25s;
}

.t-card.hidden {
  display: none;
}

@keyframes cardPop {
  from { opacity:0; transform:scale(0.82) translateY(14px); }
  to   { opacity:1; transform:scale(1)    translateY(0); }
}

.t-card-shine {
  position: absolute; inset:0;
  background: linear-gradient(135deg, var(--border-glass-hover) 0%, transparent 60%);
  pointer-events:none; border-radius:inherit;
}

.t-card-glow {
  position: absolute; inset:0;
  background: radial-gradient(ellipse at 50% 0%,rgba(var(--accent),0.18) 0%,transparent 70%);
  opacity:0; transition:opacity 0.32s; pointer-events:none; border-radius:inherit;
}

.t-card:hover {
  transform: translateY(-6px) scale(1.03);
  background: rgba(var(--accent),0.06);
  border-color: rgba(var(--accent),0.35);
  box-shadow: 0 14px 36px rgba(var(--accent),0.14),
              0 0 0 1px rgba(var(--accent),0.18),
              inset 0 1px 0 var(--border-glass);
}
.t-card:hover .t-card-glow { opacity:1; }

/* Platform badge */
.t-badge {
  position: absolute;
  top: 8px; right: 8px;
  font-size: 0.55rem;
  font-family: var(--font-mono);
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 2px 6px;
  border-radius: 999px;
  opacity: 0;
  transition: opacity 0.2s;
}

.t-badge[data-plat="web"]    { background: rgba(99,102,241,0.18); color:#818cf8; }
.t-badge[data-plat="mobile"] { background: rgba(16,185,129,0.18); color:#34d399; }
.t-badge[data-plat="both"]   { display:none; }

.platform-toggle[data-active="web"]    .t-badge,
.platform-toggle[data-active="mobile"] .t-badge { opacity:1; }

/* Icon */
.t-icon {
  position: relative; z-index:1;
  width: 58px; height: 58px;
  display:flex; align-items:center; justify-content:center;
  transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1);
  filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));
}
.t-card:hover .t-icon {
  transform: scale(1.15) translateY(-2px);
  filter: drop-shadow(0 6px 16px rgba(var(--accent),0.4));
}
.t-icon svg { width:100%; height:100%; display:block; }

/* Name */
.t-name {
  position:relative; z-index:1;
  font-size:0.76rem; font-weight:500;
  font-family:var(--font-sans);
  color: var(--text-secondary);
  text-align:center; line-height:1.3;
  transition:color 0.2s; margin:0;
}
.t-card:hover .t-name { color: var(--text-primary); }

/* Empty state */
.empty-state {
  display:flex; flex-direction:column; align-items:center;
  gap:0.75rem; padding:3rem 0; color:var(--text-muted);
  font-size:0.85rem; font-family:var(--font-sans);
}

/* ── LIGHT MODE OVERRIDES ── */
[data-theme="light"] .plat-wrapper {
  background: rgba(15,23,42,0.04);
  border-color: rgba(15,23,42,0.08);
}
[data-theme="light"] .plat-slider {
  background: rgba(15,23,42,0.08);
  border-color: rgba(15,23,42,0.15);
}
[data-theme="light"] .tab-btn {
  background: rgba(15,23,42,0.03);
  border-color: rgba(15,23,42,0.06);
}
[data-theme="light"] .tab-btn.active {
  background: rgba(15,23,42,0.1);
  border-color: rgba(15,23,42,0.2);
}
[data-theme="light"] .t-badge[data-plat="web"] {
  background: rgba(99,102,241,0.15);
  color: #4f46e5;
}
[data-theme="light"] .t-badge[data-plat="mobile"] {
  background: rgba(16,185,129,0.15);
  color: #059669;
}
</style>

<script>
// ── Data mirrors (platform per card)
const cats = [
  { id:'frontend', techs: ['both','both','web','mobile','web','mobile','web','web'] },
  { id:'backend',  techs: ['both','both','both','both','both','web','web'] },
  { id:'database', techs: ['both','both','web','both'] },
  { id:'tools',    techs: ['both'] },
];

// ── Refs
const platBtns   = document.querySelectorAll<HTMLButtonElement>('.plat-btn');
const platSlider = document.getElementById('platSlider') as HTMLElement;
const toggle     = document.getElementById('platformToggle') as HTMLElement;
const tabs       = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
const panels     = document.querySelectorAll<HTMLDivElement>('.tech-panel');

// ── Move slider to active button
function moveSlider(btn: HTMLButtonElement) {
  const nav   = btn.closest('.platform-toggle') as HTMLElement;
  const navRect = nav.getBoundingClientRect();
  const btnRect = btn.getBoundingClientRect();
  platSlider.style.width  = btnRect.width  + 'px';
  platSlider.style.transform = `translateX(${btnRect.left - navRect.left - 5}px)`;
}

// ── Filter cards
function filterPlatform(platform: string) {
  toggle.setAttribute('data-active', platform);

  cats.forEach(cat => {
    const grid    = document.getElementById(`grid-${cat.id}`)!;
    const empty   = document.getElementById(`empty-${cat.id}`)!;
    const cards   = grid.querySelectorAll<HTMLDivElement>('.t-card');
    let visible   = 0;

    cards.forEach((card, i) => {
      const plat = cat.techs[i];
      const show = platform === 'all' || plat === platform || plat === 'both';
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    // Update tab count badge
    const countBadge = document.querySelector<HTMLElement>(`.tab-count[data-cat="${cat.id}"]`);
    if (countBadge) countBadge.textContent = String(visible);

    // Empty state
    empty.style.display = visible === 0 ? 'flex' : 'none';
    grid.style.display  = visible === 0 ? 'none' : 'grid';
  });
}

// ── Platform buttons
platBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    platBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    moveSlider(btn);
    filterPlatform(btn.dataset.platform!);
  });
});

// ── Tabs
tabs.forEach(tab => {
  tab.addEventListener('click', () => {
    tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected','false'); });
    panels.forEach(p => p.classList.remove('active'));
    tab.classList.add('active');
    tab.setAttribute('aria-selected','true');
    document.getElementById(`panel-${tab.dataset.tab}`)?.classList.add('active');
  });
});

// ── Init slider on load
window.addEventListener('DOMContentLoaded', () => {
  const firstBtn = document.querySelector<HTMLButtonElement>('.plat-btn.active');
  if (firstBtn) moveSlider(firstBtn);
});
// Also handle if already loaded
const firstBtn = document.querySelector<HTMLButtonElement>('.plat-btn.active');
if (firstBtn) moveSlider(firstBtn);
</script>
