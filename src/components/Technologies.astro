---

<section id="tecnologias" class="section tech-section">
  <div class="orb orb-primary" style="width:500px;height:500px;top:-100px;left:-200px;opacity:0.12;"></div>
  <div class="orb orb-secondary" style="width:400px;height:400px;bottom:-100px;right:-150px;opacity:0.1;"></div>

  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">// STACK TECNOLÓGICO</div>
      <h2 class="section-title">
        <span class="gradient-text">Tecnologías</span>
      </h2>
      <p class="section-subtitle">
        Herramientas y tecnologías que uso para construir experiencias digitales modernas,
        escalables y de alto rendimiento.
      </p>
    </div>

    <div class="tech-grid-layout">
      {categories.map((cat, i) => (
        <div
          class={`tech-card glass reveal reveal-delay-${i + 1}`}
          style={`--accent: ${cat.accent};`}
        >
          <div class="card-top">
            <h3 class="cat-title">{cat.name}</h3>
            <div class="dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
          </div>

          <div class="icons-grid">
            {cat.techs.map((tech) => (
              <div class="tech-item" title={tech.name}>
                <div class="tech-icon" set:html={icons[tech.icon]} />
                <span class="tech-label">{tech.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-section {
    position: relative;
    overflow: hidden;
  }

  .tech-grid-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 3rem;
  }

  @media (min-width: 768px) {
    .tech-grid-layout {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Card ── */
  .tech-card {
    padding: 1.75rem;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(var(--accent), 0.18);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .tech-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at top left, rgba(var(--accent), 0.07) 0%, transparent 65%);
    pointer-events: none;
  }

  .tech-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(var(--accent), 0.14);
    border-color: rgba(var(--accent), 0.38);
  }

  /* ── Card header ── */
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.75rem;
  }

  .cat-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .dots {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot-red    { background: #ff5f57; }
  .dot-yellow { background: #febc2e; }
  .dot-green  { background: #28c840; }

  /* ── Icons grid — 4 cols by default, 3 on small ── */
  .icons-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem 0.5rem;
  }

  @media (min-width: 480px) {
    .icons-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ── Individual tech item ── */
  .tech-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.3rem;
    border-radius: var(--radius-md);
    cursor: default;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .tech-item:hover {
    background: rgba(var(--accent), 0.1);
    transform: translateY(-2px);
  }

  .tech-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tech-icon svg {
    width: 100%;
    height: 100%;
  }

  .tech-label {
    font-size: 0.7rem;
    font-family: var(--font-sans);
    color: var(--text-secondary);
    text-align: center;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 80px;
  }
</style>
