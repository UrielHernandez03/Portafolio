---
const { lang = 'es' } = Astro.props;

const t = {
  es: {
    sectionLabel: "// EXPERIENCIA",
    sectionTitle: "Mi <span class=\"gradient-text\">Experiencia</span>",
    role: "Desarrollador de Software",
    company: "Vlim",
    date: "Mayo 2026 - Agosto 2026",
    moreInfo: "Más Información",
    p1: "Desarrollo de soluciones de consultoría para distintos clientes y stacks tecnológicos, destacando un servicio de prueba de vida y validación de identidad con Google Vision API, ML Kit y MediaPipe sobre Google Cloud (Cloud Run, Cloud SQL); mantenimiento correctivo y evolutivo de sistemas en producción.",
    p2: "Desarrollo y mejora de plataformas web empresariales, participando en módulos clave para comunidades, gestión de personal y operación interna.",
    l1: "Desarrollo y mantenimiento de módulos de administración y usuario.",
    l2: "Validación y sanitización de datos, mejora de formularios e interfaces responsivas.",
    l3: "Depuración, pruebas funcionales, documentación técnica y mejora continua."
  },
  en: {
    sectionLabel: "// EXPERIENCE",
    sectionTitle: "My <span class=\"gradient-text\">Experience</span>",
    role: "Software Developer",
    company: "Vlim",
    date: "May 2026 - August 2026",
    moreInfo: "More Information",
    p1: "Development of consulting solutions for different clients and technology stacks, highlighting a proof-of-life and identity validation service with Google Vision API, ML Kit, and MediaPipe on Google Cloud (Cloud Run, Cloud SQL); corrective and evolutionary maintenance of systems in production.",
    p2: "Development and improvement of enterprise web platforms, participating in key modules for communities, personnel management, and internal operation.",
    l1: "Development and maintenance of administration and user modules.",
    l2: "Data validation and sanitization, improvement of forms and responsive interfaces.",
    l3: "Debugging, functional testing, technical documentation, and continuous improvement."
  }
}[lang as 'es' | 'en'] || t['es'];
---

<section id="experiencia" class="section experience-section">
  <div class="container">

    <div class="section-header reveal">
      <span class="section-label">{t.sectionLabel}</span>
      <h2 class="section-title" set:html={t.sectionTitle}></h2>
    </div>

    <div class="exp-card glass reveal">

      <!-- Header: logo círculo + info + botón -->
      <div class="exp-header">
        <div class="exp-logo">
          <img src="/images/vlim.jpg" alt="Vlim" />
        </div>
        <div class="exp-meta">
          <h3 class="exp-role">{t.role}</h3>
          <span class="exp-company">{t.company}</span>
          <span class="exp-date">{t.date}</span>
        </div>
        <button class="exp-toggle" id="expToggle">
          {t.moreInfo}
          <svg class="exp-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
      </div>

      <!-- Contenido expandible -->
      <div class="exp-details" id="expDetails">
        <p class="exp-summary">
          {t.p1}
        </p>
        <p class="exp-summary">
          {t.p2}
        </p>
        <ul class="exp-bullets">
          <li>{t.l1}</li>
          <li>{t.l2}</li>
          <li>{t.l3}</li>
        </ul>
        <div class="exp-tags">
          <span class="exp-tag">React</span>
          <span class="exp-tag">Node.js</span>
          <span class="exp-tag">Google Cloud</span>
          <span class="exp-tag">Cloud Run</span>
          <span class="exp-tag">Cloud SQL</span>
          <span class="exp-tag">ML Kit</span>
          <span class="exp-tag">MediaPipe</span>
          <span class="exp-tag">PHP</span>
          <span class="exp-tag">PostgreSQL</span>
          <span class="exp-tag">MongoDB</span>
          <span class="exp-tag">Moleculer</span>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .experience-section {
    padding-top: 5rem;
    padding-bottom: 6rem;
  }

  .exp-card {
    max-width: 850px;
    margin: 0 auto;
    padding: 2.5rem;
    border-radius: 20px;
    background: var(--bg-surface);
    border: 1px solid rgba(99, 102, 241, 0.25);
    box-shadow: 0 0 30px rgba(99, 102, 241, 0.08);
    transition: all 0.3s ease;
  }
  .exp-card:hover {
    box-shadow: 0 0 45px rgba(99, 102, 241, 0.15);
    transform: translateY(-2px);
  }

  /* ── Header ── */
  .exp-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* Círculo del logo */
  .exp-logo {
    width: 72px;
    height: 72px;
    background: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }
  .exp-logo img {
    width: 85%;
    height: 85%;
    object-fit: contain;
  }

  .exp-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .exp-role {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }
  .exp-company {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-top: 0.1rem;
  }
  .exp-date {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    font-family: var(--font-mono, monospace);
    margin-top: 0.3rem;
  }

  /* ── Botón ── */
  .exp-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.4rem;
    border-radius: 50px;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.25);
    color: #a5b4fc;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }
  .exp-toggle:hover {
    background: rgba(99, 102, 241, 0.2);
    border-color: rgba(99, 102, 241, 0.5);
  }
  .exp-chevron {
    transition: transform 0.3s ease;
  }
  .exp-toggle.open .exp-chevron {
    transform: rotate(180deg);
  }

  /* ── Detalles ── */
  .exp-details {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.4, 0, 0.2, 1),
                margin-top 0.3s ease,
                opacity 0.3s ease;
    overflow: hidden;
    opacity: 0;
  }
  .exp-details > * {
    overflow: hidden;
  }
  .exp-details.open {
    grid-template-rows: 1fr;
    margin-top: 2rem;
    opacity: 1;
  }
  /* Wrapper interno necesario para el grid trick */
  .exp-details {
    display: flex;
    flex-direction: column;
    max-height: 0;
  }
  .exp-details.open {
    max-height: 1000px;
  }

  .exp-summary {
    font-size: 1.05rem;
    color: var(--text-primary);
    line-height: 1.75;
    margin: 0 0 1rem 0;
  }

  .exp-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .exp-bullets li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .exp-bullets li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  .exp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .exp-tag {
    padding: 0.35rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 500;
    font-family: var(--font-mono, monospace);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  [data-theme="light"] .exp-tag {
    background: rgba(35, 83, 71, 0.08);
    border-color: rgba(35, 83, 71, 0.2);
    color: var(--color-primary);
  }

  [data-theme="light"] .exp-toggle {
    background: rgba(35, 83, 71, 0.1);
    border-color: rgba(35, 83, 71, 0.25);
    color: var(--text-primary);
  }
  
  [data-theme="light"] .exp-toggle:hover {
    background: rgba(35, 83, 71, 0.2);
    border-color: rgba(35, 83, 71, 0.4);
  }

  @media (max-width: 640px) {
    .exp-card { padding: 1.5rem; }
    .exp-header { flex-wrap: wrap; }
    .exp-toggle { width: 100%; justify-content: center; }
    .exp-role { font-size: 1.25rem; }
  }
</style>

<script>
  const btn = document.getElementById('expToggle');
  const det = document.getElementById('expDetails');
  btn?.addEventListener('click', () => {
    btn.classList.toggle('open');
    det?.classList.toggle('open');
  });
</script>
