---
/**
 * Projects.astro — Sección de proyectos del portafolio.
 * Diseño extensible: para agregar un proyecto, solo agrega otro objeto al array `projects`.
 */

interface ProjectLink {
  label: string;
  url: string;
  icon: string;
}

interface ProjectImage {
  src: string;
  alt: string;
  label: string;
  url: string;
}

interface Project {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  features: string[];
  tags: string[];
  images: ProjectImage[];
  links: ProjectLink[];
  accentColor: string;
  accentGlow: string;
}

const { lang = 'es' } = Astro.props;

const t = {
  es: {
    sectionLabel: "// PROYECTOS",
    sectionTitle1: "Mis",
    sectionTitle2: "Proyectos",
    sectionSubtitle: "Soluciones de software desarrolladas de principio a fin con tecnologías modernas y arquitecturas escalables.",
    featured: "Proyecto Destacado",
    visitSite: "Visitar sitio"
  },
  en: {
    sectionLabel: "// PROJECTS",
    sectionTitle1: "My",
    sectionTitle2: "Projects",
    sectionSubtitle: "Software solutions developed from end-to-end with modern technologies and scalable architectures.",
    featured: "Featured Project",
    visitSite: "Visit Site"
  }
}[lang as 'es' | 'en'] || { sectionLabel: "", sectionTitle1: "", sectionTitle2: "", sectionSubtitle: "", featured: "", visitSite: "" };

const projects: Project[] = [
