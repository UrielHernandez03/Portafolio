---
const { lang = "es" } = Astro.props;

const t =
  {
    es: {
      sectionLabel: "CONTACTO",
      sectionTitle: "Contacto",
      liTitle: "LinkedIn",
      liSub: "Perfil profesional",
      ghTitle: "GitHub",
      ghSub: "Código y proyectos",
      mailTitle: "Correo",
      mailSub: "Contacto directo",
      waTitle: "WhatsApp",
      waSub: "Respuesta rápida",
    },
    en: {
      sectionLabel: "CONTACT",
      sectionTitle: "Contact",
      liTitle: "LinkedIn",
      liSub: "Professional profile",
      ghTitle: "GitHub",
      ghSub: "Code and projects",
      mailTitle: "Email",
      mailSub: "Direct contact",
      waTitle: "WhatsApp",
      waSub: "Quick response",
    },
  }[lang as "es" | "en"] || t["es"];
---

<section id="contacto" class="section contact-section">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label-badge">{t.sectionLabel}</span>
      <h2 class="section-title-big">{t.sectionTitle}</h2>
    </div>

    <div class="contact-grid reveal reveal-delay-1">
      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/ortiz-hernadnez-jonathan-uriel-408a673b5/"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-card"
      >
        <div class="card-icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"
            ><path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            ></path></svg
          >
        </div>
        <div class="card-content">
          <span class="card-title">{t.liTitle}</span>
          <span class="card-sub">{t.liSub}</span>
        </div>
      </a>

      <!-- GitHub -->
      <a
        href="https://github.com/UrielHernandez03"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-card"
      >
        <div class="card-icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"
            ><path
              d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.379.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"
            ></path></svg
          >
        </div>
        <div class="card-content">
          <span class="card-title">{t.ghTitle}</span>
          <span class="card-sub">{t.ghSub}</span>
        </div>
      </a>

      <!-- Correo -->
      <a
        href="mailto:joniortiz407@gmail.com?subject=Contacto%20desde%20Portafolio"
        class="contact-card"
      >
        <div class="card-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path
              d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg
          >
        </div>
        <div class="card-content">
          <span class="card-title">{t.mailTitle}</span>
          <span class="card-sub">{t.mailSub}</span>
        </div>
      </a>

      <!-- WhatsApp -->
      <a
        href="https://wa.me/5561831309"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-card"
      >
        <div class="card-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
            ></path></svg
          >
        </div>
        <div class="card-content">
          <span class="card-title">{t.waTitle}</span>
          <span class="card-sub">{t.waSub}</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style is:global>
  .contact-section {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .section-header {
    margin-bottom: 3rem;
    text-align: left;
  }

  .section-label-badge {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-primary, #6366f1);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  [data-theme="light"] .section-label-badge {
    background: rgba(35, 83, 71, 0.1);
    color: var(--color-primary, #163832);
    border-color: rgba(35, 83, 71, 0.2);
  }

  .section-title-big {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg-surface, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--border-glass, rgba(255, 255, 255, 0.05));
    padding: 1.25rem;
    border-radius: 16px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .contact-card:hover {
    border-color: var(--color-primary, #6366f1);
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-3px);
  }

  [data-theme="light"] .contact-card:hover {
    border-color: var(--color-primary, #163832);
    background: rgba(0, 0, 0, 0.02);
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
    border-radius: 10px;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .contact-card:hover .card-icon {
    background: var(--color-primary, #6366f1);
    color: #ffffff;
  }

  [data-theme="light"] .card-icon {
    background: rgba(0, 0, 0, 0.05);
  }

  [data-theme="light"] .contact-card:hover .card-icon {
    background: var(--color-primary, #163832);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .card-title {
    font-size: 1rem;
    color: var(--text-primary);
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .card-sub {
    font-size: 0.8rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 1024px) {
    .contact-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .section-title-big {
      font-size: 2rem;
    }
  }
</style>
